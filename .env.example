# Public app URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase — use the project's URL and publishable key (sb_publishable_...).
# These are safe for browser use. NEVER expose a secret/service_role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# OpenCode server connection — set in the Happyforge web app environment
OPENCODE_SERVER_URL=
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=

# NVIDIA NIM — set on the OpenCode runtime host, NOT in browser-exposed variables
NVIDIA_API_KEY=

# GitHub OAuth / App credentials — server-side only
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional object storage (S3-compatible)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
