# Public app URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase — never expose the service role key to the browser
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenCode server — server-side only
OPENCODE_SERVER_URL=
OPENCODE_SERVER_USERNAME=
OPENCODE_SERVER_PASSWORD=

# NVIDIA NIM — server-side only
NVIDIA_API_KEY=

# GitHub OAuth / App credentials — server-side only
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional object storage (S3-compatible)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
